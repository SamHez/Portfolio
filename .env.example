# Optional public GA4 measurement ID (G-...). No analytics loads until a visitor
# opts in. Leave blank to preserve the current analytics-free experience.
NEXT_PUBLIC_GA_ID=

# Optional public Search Console verification token; never an API credential.
GOOGLE_SITE_VERIFICATION=

# Force noindex for a staging/preview build. Netlify contexts also protect previews.
# Leave blank for production. Never set true on the production Netlify context.
SITE_NOINDEX=

# Dormant hero video override; the selected default remains GradientWaves.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Dormant EmailJS PUBLIC identifiers only. The approved contact page is direct
# email/phone and does not render or load the form. No identifiers are required.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
